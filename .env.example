NODE_ENV=development
PORT=3000
DB_PATH=cambusa.sqlite
DB_AUTO_LOAD_ENTITIES=true
DB_SYNCHRONIZE=true
DB_LOGGING=false
UPLOADS_DIR=uploads

CORS_ALLOWED_ORIGINS=http://localhost:4200
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4200/api/auth/callback
OIDC_FRONTEND_REDIRECT_BASE_URL=http://localhost:4200

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER="Cambusa" <notifications@cambusa.local>
